# Copy to backend/.env and fill in. Never commit the real file.
#
# Hosted project: Supabase dashboard -> Project Settings -> API
# Local (`supabase start`): the CLI prints all three on startup.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Bypasses RLS. Used only by the extraction job, which has no request context.
# Server-side only — never ship this to the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated. Vite's default dev origin.
CORS_ORIGINS=http://localhost:5173

ENVIRONMENT=development
